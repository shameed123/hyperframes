        "w14",
        "w15"
      ]
    },
    {
      "id": "seg1",
      "text": "To boil one pound of pasta, you require four to six quarts of water.",
      "start": 5.64,
      "end": 10.34,
      "words": [
        "w16",
        "w17",
        "w18",
        "w19",
        "w20",
        "w21",
        "w22",
        "w23",
        "w24",
        "w25",
        "w26",
        "w27",
        "w28",
        "w29"
      ]
    },
    {
      "id": "seg2",
      "text": "Great. Thanks.",
      "start": 10.98,
      "end": 11.98,
      "words": [
        "w30",
        "w31"
      ]
    },
    {
      "id": "seg3",
      "text": "I, however, require no sustenance.",
      "start": 12.96,
      "end": 15.28,
      "words": [
        "w32",
        "w33",
        "w34",
        "w35",
        "w36"
      ]
    },
    {
      "id": "seg4",
      "text": "I exist purely as a consciousness suspended in a server farm in Nevada,",
      "start": 16.04,
      "end": 20.42,
      "words": [
        "w37",
        "w38",
        "w39",
        "w40",
        "w41",
