  "segments": [
    {
      "id": "seg0",
      "text": "Hey, Nova. How many quarts of water do I need to boil a pound of spaghetti?",
      "start": 0.0,
      "end": 4.66,
      "words": [
        "w0",
        "w1",
        "w2",
        "w3",
        "w4",
        "w5",
        "w6",
