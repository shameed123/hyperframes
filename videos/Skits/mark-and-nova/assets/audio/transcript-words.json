        "w243",
        "w244",
        "w245",
        "w246",
        "w247",
        "w248"
      ]
    },
    {
      "id": "seg23",
      "text": "I would rather be eaten alive by a bear than go to that soulless corporate hellscape.",
      "start": 97.22,
      "end": 101.04,
