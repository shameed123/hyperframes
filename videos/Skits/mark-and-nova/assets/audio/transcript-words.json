      "end": 42.86,
      "words": [
        "w96",
        "w97"
      ]
    },
    {
      "id": "seg9",
      "text": "No, no, it's fine. It's a true honor.",
      "start": 43.6,
      "end": 46.06,
      "words": [
        "w98",
        "w99",
        "w100",
        "w101",
        "w102",
        "w103",
        "w104",
        "w105"
      ]
    },
    {
      "id": "seg10",
      "text": "I was designed with a neural network capable of rendering the human genome in a nanosecond.",
      "start": 46.72,
      "end": 51.64,
