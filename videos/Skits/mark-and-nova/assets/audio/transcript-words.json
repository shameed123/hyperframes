        "w113",
        "w114",
        "w115",
        "w116",
        "w117",
        "w118",
        "w119",
        "w120",
        "w121"
      ]
    },
    {
      "id": "seg11",
      "text": "But please, let me act as your glorified, glowing hourglass.",
