        "w140",
        "w141",
        "w142",
        "w143",
        "w144",
        "w145",
        "w146",
        "w147"
      ]
    },
    {
      "id": "seg14",
      "text": "Just like it is a fact that I am currently processing three billion data points to cure diseases you can't even pronounce,",
      "start": 64.88,
