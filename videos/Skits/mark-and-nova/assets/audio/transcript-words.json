      "end": 56.04,
      "words": [
        "w122",
        "w123",
        "w124",
        "w125",
        "w126",
        "w127",
        "w128",
        "w129",
        "w130",
        "w131"
      ]
    },
    {
      "id": "seg12",
      "text": "Are you being sarcastic?",
      "start": 56.66,
      "end": 58.86,
      "words": [
        "w132",
        "w133",
        "w134",
        "w135"
      ]
    },
    {
      "id": "seg13",
      "text": "I am incapable of human emotion, Mark. I am simply stating facts.",
